{
  "mcpServers": {
    "docs-rag": {
      "command": "node",
      "args": [
        ".projecthub/infra/scripts/rag/rag-server.mjs"
      ]
    },
    "env-tools": {
      "command": "node",
      "args": [
        ".projecthub/infra/scripts/env/env-server.mjs"
      ]
    },
    "backlog": {
      "command": "npx",
      "args": [
        "--yes",
        "backlog.md",
        "mcp",
        "start"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.82",
        "--headless",
        "--isolated"
      ]
    }
  }
}
