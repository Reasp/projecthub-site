---
// Главная: один компонент на обе локали, строки из словаря.
import Site from '../layouts/Site.astro';
import { t, localePath, fill, type Locale } from '../i18n';
import { SOURCE_CLONE, VERSION, teamPriceRange } from '../data/product';
import shot from '../../content/product/assets/task-142-6/08-phone-hitl-1.png';
import { Image } from 'astro:assets';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const p = d.pricing;
---

<Site locale={locale} title={d.home.title} description={d.home.description} current="home">
  <section class="hero">
    <div class="kicker">{d.home.kicker}</div>
    <h1>{d.home.heading}</h1>
    <p class="lead">{d.home.lead}</p>
    <div class="cta">
      <a class="btn primary" href={localePath(locale, '/download/')}>{d.home.ctaDownload}</a>
      <a class="btn" href={localePath(locale, '/docs/')}>{d.home.ctaDocs}</a>
    </div>
  </section>

  <section>
    <h2>{d.home.pointsTitle}</h2>
    <div class="grid">
      {d.home.points.map((point) => (
        <div class="card">
          <h3>{point.title}</h3>
          <p>{point.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>{d.home.demoTitle}</h2>
    <div class="grid">
      <div class="placeholder">{d.home.demoPlaceholder}</div>
      <Image src={shot} alt="ProjectHub: approval request on a phone" class="shot" widths={[480, 960]} sizes="(max-width: 640px) 100vw, 520px" />
    </div>
  </section>

  <section>
    <h2>{d.home.installTitle}</h2>
    <p>{d.home.installLead}</p>
    <pre><code>{SOURCE_CLONE}</code></pre>
    <p class="note">{d.home.installNote}</p>
  </section>

  <section>
    <h2>{d.home.editionsTitle}</h2>
    <p class="lead">{d.home.editionsLead}</p>
    <div class="grid">
      <div class="card"><h3>{p.personal.name}</h3><p>{p.free} · {p.mit}</p><p class="note">{p.personal.audience}</p></div>
      <div class="card"><h3>{p.team.name}</h3><p>{teamPriceRange()} {p.perSeatMonth}</p><p class="note">{p.team.status}</p></div>
      <div class="card"><h3>{p.enterprise.name}</h3><p>{p.contract}</p><p class="note">{p.enterprise.status}</p></div>
    </div>
    <p><a href={localePath(locale, '/pricing/')}>{d.home.editionsMore}</a></p>
  </section>

  <section>
    <h2>{d.home.statusTitle}</h2>
    <p class="status">{fill(d.home.statusText, { version: VERSION })}</p>
  </section>
</Site>
