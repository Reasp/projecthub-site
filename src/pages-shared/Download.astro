---
import Site from '../layouts/Site.astro';
import { t, fill, localePath, type Locale } from '../i18n';
import { LINKS, RELEASES, VERSION } from '../data/product';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale).download;
const sup = t(locale).support;
const builds = RELEASES.builds ?? [];
---

<Site locale={locale} title={d.title} description={d.description} current="download">
  <section class="hero">
    <h1>{d.heading}</h1>
    <p class="lead">{d.lead}</p>
  </section>

  <section>
    <h2>{d.buildsTitle}</h2>
    {builds.length === 0 ? (
      <>
        <p class="status-box">{fill(d.noBuilds, { version: VERSION })}</p>
        {LINKS.sourceRepository && <p><a class="btn" href={LINKS.sourceRepository} rel="noopener">{t(locale).footer.source} · GitHub</a></p>}
      </>
    ) : (
      <>
        {RELEASES.published && <p class="note">{d.published}: {RELEASES.published} · {RELEASES.version}</p>}
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>{d.columns.platform}</th><th>{d.columns.format}</th><th>{d.columns.file}</th><th>{d.columns.checksum}</th></tr>
            </thead>
            <tbody>
              {builds.map((build) => (
                <tr>
                  <td>{build.platform}</td>
                  <td>{build.format}</td>
                  <td><a href={build.url}>{build.file}</a></td>
                  <td><code>{build.sha256}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
  </section>

  <section class="reveal">
    <div class="support-card">
      <div><h2>{sup.heading}</h2><p class="lead">{sup.downloadAsk}</p></div>
      <a class="btn primary" href={LINKS.donate ?? localePath(locale, '/support/')} rel="noopener">{sup.downloadCta}</a>
    </div>
  </section>

  <section>
    <h2>{d.plannedTitle}</h2>
    <ul>{d.planned.map((item) => <li>{item}</li>)}</ul>
    <p class="note">{d.updates}</p>
  </section>
</Site>
