---
// Три схемы: Personal, Team, Enterprise — инлайн-SVG на данных словаря, без внешних ресурсов. Стили — в
// global.css (.scheme*). Подписи узлов переводятся словарём, геометрия общая для обеих локалей.
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale).scenarios;

type Node = { id: string; x: number; y: number; w: number; h: number; label: string; kind?: 'hero' | 'soft' | 'warn' | 'dash' };
type Edge = { from: string; to: string; label?: string; dashed?: boolean };

const personalNodes: Node[] = [
  { id: 'you', x: 40, y: 150, w: 120, h: 56, label: s.personal.nodes.you, kind: 'hero' },
  { id: 'desktop', x: 230, y: 70, w: 190, h: 56, label: s.personal.nodes.desktop, kind: 'hero' },
  { id: 'phone', x: 230, y: 230, w: 190, h: 56, label: s.personal.nodes.phone, kind: 'soft' },
  { id: 'a1', x: 500, y: 30, w: 170, h: 48, label: s.personal.nodes.agents[0] },
  { id: 'a2', x: 500, y: 110, w: 170, h: 48, label: s.personal.nodes.agents[1] },
  { id: 'a3', x: 500, y: 190, w: 170, h: 48, label: s.personal.nodes.agents[2] },
  { id: 'repo', x: 740, y: 110, w: 180, h: 56, label: s.personal.nodes.repo, kind: 'soft' },
  { id: 'audit', x: 500, y: 270, w: 170, h: 44, label: s.personal.nodes.audit, kind: 'dash' }
];
const personalEdges: Edge[] = [
  { from: 'you', to: 'desktop' },
  { from: 'you', to: 'phone', label: s.personal.nodes.approvals },
  { from: 'desktop', to: 'a1' }, { from: 'desktop', to: 'a2' }, { from: 'desktop', to: 'a3' },
  { from: 'a1', to: 'repo', label: s.personal.nodes.worktree }, { from: 'a2', to: 'repo' }, { from: 'a3', to: 'repo' },
  { from: 'phone', to: 'desktop', dashed: true },
  { from: 'desktop', to: 'audit', dashed: true }
];

const teamNodes: Node[] = [
  { id: 'm1', x: 30, y: 40, w: 170, h: 48, label: s.team.nodes.members[0] },
  { id: 'm2', x: 30, y: 130, w: 170, h: 48, label: s.team.nodes.members[1] },
  { id: 'm3', x: 30, y: 220, w: 170, h: 48, label: s.team.nodes.members[2] },
  { id: 'host', x: 290, y: 110, w: 200, h: 64, label: s.team.nodes.host, kind: 'hero' },
  { id: 'queue', x: 570, y: 110, w: 170, h: 64, label: s.team.nodes.queue, kind: 'warn' },
  { id: 'main', x: 820, y: 118, w: 110, h: 48, label: s.team.nodes.main, kind: 'soft' },
  { id: 'budgets', x: 260, y: 240, w: 250, h: 44, label: s.team.nodes.budgets, kind: 'dash' },
  { id: 'checks', x: 520, y: 230, w: 290, h: 44, label: s.team.nodes.checks, kind: 'dash' },
  { id: 'chat', x: 270, y: 14, w: 240, h: 44, label: s.team.nodes.chat, kind: 'dash' }
];
const teamEdges: Edge[] = [
  { from: 'm1', to: 'host', label: s.team.nodes.worktrees }, { from: 'm2', to: 'host' }, { from: 'm3', to: 'host' },
  { from: 'host', to: 'queue' }, { from: 'queue', to: 'main' },
  { from: 'host', to: 'budgets', dashed: true }, { from: 'queue', to: 'checks', dashed: true },
  { from: 'host', to: 'chat', dashed: true }
];

const enterpriseNodes: Node[] = [
  { id: 'perimeter', x: 30, y: 20, w: 900, h: 300, label: s.enterprise.nodes.perimeter, kind: 'dash' },
  { id: 'h1', x: 70, y: 80, w: 190, h: 56, label: s.enterprise.nodes.hosts[0], kind: 'hero' },
  { id: 'h2', x: 70, y: 200, w: 190, h: 56, label: s.enterprise.nodes.hosts[1], kind: 'hero' },
  { id: 'relay', x: 340, y: 80, w: 200, h: 56, label: s.enterprise.nodes.relay },
  { id: 'models', x: 340, y: 200, w: 200, h: 56, label: s.enterprise.nodes.models },
  { id: 'siem', x: 620, y: 60, w: 290, h: 48, label: s.enterprise.nodes.siem, kind: 'soft' },
  { id: 'policy', x: 620, y: 140, w: 290, h: 48, label: s.enterprise.nodes.policy, kind: 'soft' },
  { id: 'sandbox', x: 620, y: 220, w: 290, h: 48, label: s.enterprise.nodes.sandbox, kind: 'soft' }
];
const enterpriseEdges: Edge[] = [
  { from: 'h1', to: 'relay' }, { from: 'h2', to: 'relay' }, { from: 'h1', to: 'models' }, { from: 'h2', to: 'models' },
  { from: 'relay', to: 'siem', dashed: true }, { from: 'relay', to: 'policy', dashed: true }, { from: 'models', to: 'sandbox', dashed: true }
];

const scenes = [
  { key: 'personal', title: s.personal.title, subtitle: s.personal.subtitle, caption: s.personal.caption, nodes: personalNodes, edges: personalEdges, h: 330 },
  { key: 'team', title: s.team.title, subtitle: s.team.subtitle, caption: s.team.caption, nodes: teamNodes, edges: teamEdges, h: 300 },
  { key: 'enterprise', title: s.enterprise.title, subtitle: s.enterprise.subtitle, caption: s.enterprise.caption, nodes: enterpriseNodes, edges: enterpriseEdges, h: 340 }
];

const center = (n: Node) => ({ cx: n.x + n.w / 2, cy: n.y + n.h / 2 });
function path(nodes: Node[], e: Edge): { d: string; mx: number; my: number } {
  const a = nodes.find((n) => n.id === e.from)!;
  const b = nodes.find((n) => n.id === e.to)!;
  const A = center(a);
  const B = center(b);
  // Выход из правой/левой грани, если узлы в разных колонках; иначе из нижней/верхней.
  const horizontal = Math.abs(A.cx - B.cx) > Math.abs(A.cy - B.cy);
  const x1 = horizontal ? (A.cx < B.cx ? a.x + a.w : a.x) : A.cx;
  const y1 = horizontal ? A.cy : A.cy < B.cy ? a.y + a.h : a.y;
  const x2 = horizontal ? (A.cx < B.cx ? b.x : b.x + b.w) : B.cx;
  const y2 = horizontal ? B.cy : A.cy < B.cy ? b.y : b.y + b.h;
  const c = horizontal ? `C ${(x1 + x2) / 2} ${y1}, ${(x1 + x2) / 2} ${y2}, ${x2} ${y2}` : `C ${x1} ${(y1 + y2) / 2}, ${x2} ${(y1 + y2) / 2}, ${x2} ${y2}`;
  return { d: `M ${x1} ${y1} ${c}`, mx: (x1 + x2) / 2, my: (y1 + y2) / 2 };
}
---

<div class="schemes">
  {scenes.map((scene) => (
    <figure class={`scheme scheme-${scene.key}`}>
      <figcaption>
        <strong>{scene.title}</strong>
        <span>{scene.subtitle}</span>
      </figcaption>
      <div class="scheme-scroll">
      <svg viewBox={`0 0 960 ${scene.h}`} role="img" aria-label={`${scene.title}: ${scene.caption}`}>
        <defs>
          <linearGradient id={`g-${scene.key}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--accent)" />
            <stop offset="1" stop-color="var(--accent-2)" />
          </linearGradient>
          <marker id={`arrow-${scene.key}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--accent)" />
          </marker>
        </defs>
        {scene.edges.map((e) => {
          const p = path(scene.nodes, e);
          return (
            <g class={e.dashed ? 'edge dashed' : 'edge'}>
              <path d={p.d} marker-end={`url(#arrow-${scene.key})`} />
              {e.label && <text x={p.mx} y={p.my - 8} text-anchor="middle" class="edge-label">{e.label}</text>}
            </g>
          );
        })}
        {scene.nodes.map((n) => (
          <g class={`node ${n.kind ?? ''}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12" fill={n.kind === 'hero' ? `url(#g-${scene.key})` : undefined} />
            {n.kind === 'dash' && n.w > 600 ? (
              <text x={n.x + 16} y={n.y + 26} text-anchor="start">{n.label}</text>
            ) : (
              <text x={n.x + n.w / 2} y={n.y + n.h / 2 + 5} text-anchor="middle">{n.label}</text>
            )}
          </g>
        ))}
      </svg>
      </div>
      <p>{scene.caption}</p>
    </figure>
  ))}
</div>
